{
  "name": "@yysubs/vue-fluent-kit",
  "version": "0.2.0",
  "description": "Lightweight Vue 3 thin-wrapper component library built on @fluentui/web-components (Fluent 2).",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yysubs/vue-fluent-kit.git"
  },
  "homepage": "https://github.com/yysubs/vue-fluent-kit#readme",
  "bugs": {
    "url": "https://github.com/yysubs/vue-fluent-kit/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "fluent-ui",
    "fluent-2",
    "web-components",
    "component-library",
    "ui"
  ],
  "packageManager": "pnpm@10.34.9",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./custom-elements": {
      "types": "./dist/custom-elements.d.ts",
      "import": "./dist/custom-elements.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox/index.d.ts",
      "import": "./dist/combobox.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog/index.d.ts",
      "import": "./dist/dialog.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/index.d.ts",
      "import": "./dist/drawer.js"
    },
    "./field": {
      "types": "./dist/components/field/index.d.ts",
      "import": "./dist/field.js"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/input.js"
    },
    "./menu": {
      "types": "./dist/components/menu/index.d.ts",
      "import": "./dist/menu.js"
    },
    "./radio": {
      "types": "./dist/components/radio/index.d.ts",
      "import": "./dist/radio.js"
    },
    "./search-box": {
      "types": "./dist/components/search-box/index.d.ts",
      "import": "./dist/search-box.js"
    },
    "./select": {
      "types": "./dist/components/select/index.d.ts",
      "import": "./dist/select.js"
    },
    "./swatch-picker": {
      "types": "./dist/components/swatch-picker/index.d.ts",
      "import": "./dist/swatch-picker.js"
    },
    "./switch": {
      "types": "./dist/components/switch/index.d.ts",
      "import": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/tabs.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea/index.d.ts",
      "import": "./dist/textarea.js"
    },
    "./toggle-button": {
      "types": "./dist/components/toggle-button/index.d.ts",
      "import": "./dist/toggle-button.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./tree": {
      "types": "./dist/components/tree/index.d.ts",
      "import": "./dist/tree.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/badge*.js",
    "./dist/button*.js",
    "./dist/checkbox*.js",
    "./dist/combobox*.js",
    "./dist/dialog*.js",
    "./dist/drawer*.js",
    "./dist/field*.js",
    "./dist/input*.js",
    "./dist/VfkInput*.js",
    "./dist/menu*.js",
    "./dist/radio*.js",
    "./dist/search-box*.js",
    "./dist/select*.js",
    "./dist/swatch-picker*.js",
    "./dist/switch*.js",
    "./dist/tabs*.js",
    "./dist/textarea*.js",
    "./dist/toggle-button*.js",
    "./dist/tooltip*.js",
    "./dist/tree*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-style.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@fluentui/tokens": "1.0.0-alpha.25",
    "@fluentui/web-components": "^3.2.5"
  }
}
