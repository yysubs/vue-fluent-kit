{
  "name": "@yysubs/vue-fluent-kit",
  "version": "0.0.0",
  "description": "Lightweight Vue 3 thin-wrapper component library built on @fluentui/web-components (Fluent 2).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yysubs/vue-fluent-kit.git"
  },
  "homepage": "https://github.com/yysubs/vue-fluent-kit#readme",
  "bugs": {
    "url": "https://github.com/yysubs/vue-fluent-kit/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "fluent-ui",
    "fluent-2",
    "web-components",
    "component-library",
    "ui"
  ],
  "packageManager": "pnpm@10.34.9",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./custom-elements": {
      "types": "./dist/custom-elements.d.ts",
      "import": "./dist/custom-elements.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/input.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/button*.js",
    "./dist/input*.js",
    "./dist/checkbox*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-style.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@fluentui/tokens": "1.0.0-alpha.25",
    "@fluentui/web-components": "^3.2.5"
  }
}
